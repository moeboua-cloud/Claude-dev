# Agentic IAM Platform - Environment Configuration
# Copy to .env and adjust values

# Application
IAM_ENVIRONMENT=local
IAM_DEBUG=true
IAM_LOG_LEVEL=DEBUG

# Database
IAM_DATABASE_URL=postgresql+asyncpg://iam_user:iam_pass@localhost:5432/agentic_iam

# Redis
IAM_REDIS_URL=redis://localhost:6379/0

# JWT (change in production!)
IAM_JWT_SECRET_KEY=local-dev-secret-change-me

# LLM Provider: mock | openai | anthropic
IAM_LLM_PROVIDER=mock
IAM_LLM_API_KEY=
IAM_LLM_MODEL=gpt-4

# Action mode: read_only | simulation | approval_required | execution
IAM_ACTION_MODE=simulation

# Connector mode: mock | live
IAM_CONNECTOR_MODE=mock
